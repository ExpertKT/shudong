# 复制成 server/.env 后改。所有 LLM 都走 OpenAI 兼容协议，换供应商只换这三个。
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama-placeholder
LLM_MODEL=qwen3.5:9b
# Qwen3.5 不关思考会把 token 全烧在 reasoning 上、content 是空的
LLM_REASONING_OFF=true

# 可选：便宜档，用于"更新印象"这种低价值调用。留空则复用上面那档。
# SMALL_BASE_URL=
# SMALL_API_KEY=
# SMALL_MODEL=

PORT=8787
AGENTS_PER_POST=3
MAX_INFLIGHT=6

# 成本闸门：token 数，不是钱。0 = 不限额。超了就不接新帖子（429）。
USER_DAILY_TOKENS=30000
GLOBAL_DAILY_TOKENS=300000

# 同一个网名 15 分钟内最多允许失败几次登录。0 = 不拦（不建议）。
LOGIN_MAX_FAILS=8

# 上线必须设：换成一段随机字符串。生产模式下不设（或短于 16 字符）会拒绝启动。
# SESSION_SECRET=

# 【记忆与关系】两个开关默认关着（都是"不用人开口就花钱"的调用）。
# PROACTIVE=1 才会主动来消息；阈值演示时可以放宽，真实默认是 720 分钟 / 每天 1 条。
# DM_MEMORY=1 才会把聊过的东西写进 impressions（"他记得你"这句话的来源）。
# PROACTIVE=1
# PROACTIVE_MIN_GAP_MIN=720
# PROACTIVE_DAILY_MAX=1
# DM_MEMORY=1

# 下面两个默认跟着 NODE_ENV=production 走，一般不用写。
# 单进程上线：server 顺便把 web/dist 吐出去（先跑一次 pnpm --filter @shudong/web build）
# SERVE_WEB=1
# cookie 的 Secure 标记。纯 http 试生产必须关 —— 开了浏览器根本不存这个 cookie。
# COOKIE_SECURE=0
